<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             x:Class="ClinicHub.SmsAgent.ScanPage"
             Title="Сканирование QR">

    <Grid RowDefinitions="*,Auto">
        <scanner:CameraView x:Name="Camera" Grid.Row="0"
                            CameraEnabled="False"
                            BarcodeSymbologies="QRCode"
                            VibrationOnDetected="False"
                            OnDetectionFinished="OnDetected" />

        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="10">
            <Label Text="Наведите камеру на QR-код, который показывает админка: вкладка «Телефоны» → «Подключить по QR»."
                   LineBreakMode="WordWrap" />
            <Button Text="Отмена" Clicked="OnCancelClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
