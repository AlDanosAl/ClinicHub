@page "/"
@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.Unicode
@inject IOptionsSnapshot<SiteContent> Content

@{
    var site = Content.Value;
    var c = site.Clinic;
}

<Seo Title="@($"{c.Name} — {c.Tagline.ToLowerInvariant()} в {CityPrepositional(c.City)}")"
     Description="@($"{c.Tagline} {c.Name}: консультация врача-косметолога, уход за кожей, аппаратные и инъекционные методики. Онлайн-запись, напоминания в мессенджерах и по SMS.")">
    <script type="application/ld+json">@((MarkupString)JsonLd(c))</script>
</Seo>

<section class="container hero" aria-labelledby="hero-title">
    <div class="hero__text">
        <p class="eyebrow">@c.Tagline · @c.City</p>
        <h1 id="hero-title" class="display">Косметология, где сначала смотрит врач</h1>
        <p class="lead">Процедуры назначает врач-косметолог после осмотра и консультации. Перед визитом напомним о нём в удобном мессенджере или по SMS.</p>
        <div class="row-wrap">
            <a class="btn btn--primary btn--lg" href="/zapis?service=consultation">Записаться на консультацию</a>
            <a class="btn btn--outline btn--lg" href="@c.TelegramUrl" rel="noopener">Задать вопрос в Telegram</a>
        </div>
        <ul class="facts" aria-label="Коротко о клинике">
            <li>м. @c.Metro</li>
            <li>@c.Hours</li>
            <li>Лицензия @c.License</li>
        </ul>
    </div>
    <div class="photo-slot hero__photo" role="img" aria-label="Место для фотографии интерьера клиники или кабинета врача">[ФОТО: кабинет или врач на приёме]</div>
</section>

<section class="container quick" aria-label="Быстрая запись">
    <form class="quick__form card" method="get" action="/zapis">
        <div class="field">
            <label for="q-service">Услуга</label>
            <select id="q-service" name="service">
                @foreach (var s in site.Services)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="q-doctor">Врач</label>
            <select id="q-doctor" name="doctor">
                <option value="@BookingQuery.AnyDoctor">Любой свободный</option>
                @foreach (var d in site.Doctors)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>
        <button class="btn btn--dark quick__submit" type="submit">Показать свободное время</button>
    </form>
</section>

<section id="services" class="band" aria-labelledby="services-title">
    <div class="container stack-lg">
        <div class="section-head">
            <h2 id="services-title" class="h2">Услуги и цены</h2>
        </div>
        <div class="cards">
            @foreach (var s in site.Services)
            {
                <article class="card card--soft service">
                    <h3 class="h3">@s.Name</h3>
                    <p class="muted">@s.Text</p>
                    <div class="service__foot">
                        <span class="price">@s.Price</span>
                        <a href="/zapis?service=@s.Id">Записаться</a>
                    </div>
                </article>
            }
        </div>
        <p class="note">Имеются противопоказания. Необходима консультация специалиста.</p>
    </div>
</section>

<section id="doctors" class="container section stack-lg" aria-labelledby="doctors-title">
    <h2 id="doctors-title" class="h2">Врачи</h2>
    <div class="cards">
        @foreach (var d in site.Doctors)
        {
            <article class="doctor">
                <div class="photo-slot photo-slot--doctor" role="img" aria-label="Место для фотографии врача">[ФОТО ВРАЧА]</div>
                <h3 class="h3">@d.Name</h3>
                <p class="muted">@d.Role</p>
                <a href="/zapis?doctor=@d.Id">Записаться к врачу</a>
            </article>
        }
    </div>
</section>

<section id="results" class="band" aria-labelledby="results-title">
    <div class="container split">
        <div class="split__aside stack">
            <h2 id="results-title" class="h2">До и после</h2>
            <p class="muted-strong">Публикуем фотографии только с письменного согласия пациента. На каждой карточке указаны процедура, число сеансов и время между снимками.</p>
        </div>
        <div class="split__main cards">
            @foreach (var r in site.Results)
            {
                <figure class="result">
                    <div class="photo-slot photo-slot--result" role="img" aria-label="Место для пары фото до и после">@r.ConsentNote</div>
                    <figcaption class="muted small">@r.Caption</figcaption>
                </figure>
            }
        </div>
    </div>
</section>

<section id="reviews" class="container section split" aria-labelledby="reviews-title">
    <div class="split__aside stack">
        <h2 id="reviews-title" class="h2">Отзывы</h2>
        <p class="muted-strong">Собираем отзывы на ПроДокторов и Яндекс Картах. Там их проверяют модераторы, поэтому на сайте мы показываем ссылки, а не пересказ.</p>
        <div class="row-wrap">
            @if (c.ProDoktorov is { } pd)
            {
                <a class="btn btn--outline" href="@pd.Url" rel="noopener">ПроДокторов · @pd.Rating</a>
            }
            @if (c.YandexMaps is { } ym)
            {
                <a class="btn btn--outline" href="@ym.Url" rel="noopener">Яндекс Карты · @ym.Rating</a>
            }
        </div>
    </div>
    @if (site.Review is { } review)
    {
        <blockquote class="card review">
            <p>@review.Text</p>
            <footer class="muted small">@review.Signature</footer>
        </blockquote>
    }
</section>

<section class="channels" aria-labelledby="channels-title">
    <div class="container channels__row">
        <div class="stack-sm channels__text">
            <h2 id="channels-title" class="h2 h2--sm">Напоминания и новости там, где вам удобно</h2>
            <p>Подключите бота клиники. Через него можно подтвердить или перенести визит одной кнопкой. Акции присылаем, только если вы сами на них подпишетесь.</p>
        </div>
        <div class="row-wrap">
            <a class="btn btn--light" href="@c.TelegramUrl" rel="noopener">Telegram</a>
            <a class="btn btn--light" href="@c.MaxUrl" rel="noopener">MAX</a>
            <a class="btn btn--light" href="@c.VkUrl" rel="noopener">ВКонтакте</a>
        </div>
    </div>
</section>

<section id="blog" class="container section stack-lg" aria-labelledby="blog-title">
    <h2 id="blog-title" class="h2">Статьи врачей</h2>
    <div class="cards">
        @foreach (var p in site.Posts)
        {
            <article class="post">
                <span class="muted small">@p.Tag</span>
                @if (string.IsNullOrEmpty(p.Url))
                {
                    <h3 class="post__title">@p.Title</h3>
                }
                else
                {
                    <h3 class="post__title"><a href="@p.Url">@p.Title</a></h3>
                }
            </article>
        }
    </div>
</section>

@code {
    private static string CityPrepositional(string city) =>
        city == "Санкт-Петербург" ? "Санкт-Петербурге" : city;

    /// <summary>Микроразметка schema.org для поисковиков (PLAN, задача 4.2).</summary>
    private string JsonLd(ClinicInfo c)
    {
        var data = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "MedicalClinic",
            ["name"] = c.Name,
            ["legalName"] = c.LegalName,
            ["telephone"] = c.Phone,
            ["openingHours"] = c.Hours,
            ["address"] = new Dictionary<string, object?>
            {
                ["@type"] = "PostalAddress",
                ["addressLocality"] = c.City,
                ["streetAddress"] = c.Address,
                ["addressCountry"] = "RU",
            },
            ["medicalSpecialty"] = "Dermatology",
        };
        // Кириллица как есть; < > & ' экранируются всегда, так что закрыть <script> изнутри нельзя.
        return JsonSerializer.Serialize(data, JsonLdOptions);
    }

    private static readonly JsonSerializerOptions JsonLdOptions = new()
    {
        Encoder = JavaScriptEncoder.Create(UnicodeRanges.All),
    };
}
